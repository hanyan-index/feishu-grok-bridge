# ============================================
# 飞书应用配置
# ============================================

# 飞书应用 ID（从飞书开放平台应用详情页获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx

# 飞书应用 Secret（从飞书开放平台应用详情页获取）
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书事件订阅加密密钥（从飞书开放平台「事件与回调」获取）
# 留空表示不解密、不验签。填上之后，请求体是 {"encrypt":"..."}，
# 并且每个请求都必须带 X-Lark-Signature，否则直接 403。
FEISHU_ENCRYPT_KEY=

# 飞书 Verification Token（可选）。留空则不校验；填上后会比对事件里的 token
FEISHU_VERIFICATION_TOKEN=

# 长连接的开放平台域名。留空或 feishu 表示 open.feishu.cn；国际版 Lark 填 lark
FEISHU_DOMAIN=feishu

# 本地开发端口（npm run dev）
PORT=3000

# ============================================
# SMTP 邮件配置（以 QQ 邮箱为例）
# ============================================

# SMTP 服务器地址
SMTP_HOST=smtp.qq.com

# SMTP 端口（QQ邮箱使用 587）
SMTP_PORT=587

# 发件人邮箱（你的QQ邮箱）
SMTP_USER=your_qq@qq.com

# QQ邮箱授权码（不是登录密码！在QQ邮箱设置中生成）
SMTP_PASS=your_authorization_code

# 收件人邮箱（通常也是你的QQ邮箱）
TO_EMAIL=your_qq@qq.com
